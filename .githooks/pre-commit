#!/bin/sh

# Find the nearest pubspec.yaml for a file path and print the package name
resolve_package() {
  dir=$(dirname "$1")
  while [ "$dir" != "." ]; do
    if [ -f "$dir/pubspec.yaml" ]; then
      grep '^name:' "$dir/pubspec.yaml" | head -1 | sed 's/name: *//'
      return
    fi
    dir=$(dirname "$dir")
  done
}

# Resolve each staged file under packages/ to its package name
STAGED_FILES=$(git diff --cached --name-only | grep '^packages/')

if [ -z "$STAGED_FILES" ]; then
  echo "No package changes staged, skipping pre-commit checks."
  exit 0
fi

NAMES=""
for file in $STAGED_FILES; do
  name=$(resolve_package "$file")
  if [ -n "$name" ]; then
    NAMES="$NAMES $name"
  fi
done
NAMES=$(echo "$NAMES" | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/^ *//;s/ *$//')

if [ -z "$NAMES" ]; then
  echo "No packages found in staged changes, skipping pre-commit checks."
  exit 0
fi

SCOPE=""
for name in $NAMES; do
  SCOPE="$SCOPE --scope=$name"
done

# Locate the fvm SDK so formatting and analysis match melos `sdkPath` and CI's
# analyze gate. `.fvm/` is gitignored, so a linked worktree often has no copy of
# it -- fall back to the main worktree's, which every linked worktree shares.
resolve_sdk() {
  if [ -x .fvm/flutter_sdk/bin/dart ]; then
    echo "$(pwd)/.fvm/flutter_sdk"
    return
  fi
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  if [ -n "$common_dir" ] && [ -x "$(dirname "$common_dir")/.fvm/flutter_sdk/bin/dart" ]; then
    echo "$(dirname "$common_dir")/.fvm/flutter_sdk"
  fi
}

# git exports an absolute GIT_DIR to hooks. The Flutter SDK determines its own
# version by running git inside its checkout, which then resolves against this
# repository instead and reports `0.0.0-unknown`, so pub refuses to resolve any
# package with a Flutter SDK constraint. Clear the inherited git environment for
# the nested tools; they rediscover this repository from the working directory.
run_without_git_env() {
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE "$@"
}

SDK=$(resolve_sdk)
if [ -z "$SDK" ]; then
  echo "The development Flutter SDK is missing. Run 'fvm install'." >&2
  exit 1
fi
EXPECTED_FLUTTER=$(jq -er '.flutter' .fvmrc) || exit 1
INSTALLED_FLUTTER=$(run_without_git_env "$SDK/bin/flutter" --version --machine) || exit 1
INSTALLED_FLUTTER=$(printf '%s' "$INSTALLED_FLUTTER" | jq -er '.frameworkVersion') || exit 1
if [ "$INSTALLED_FLUTTER" != "$EXPECTED_FLUTTER" ]; then
  echo "Expected Flutter $EXPECTED_FLUTTER from .fvmrc, found $INSTALLED_FLUTTER. Run 'fvm install'." >&2
  exit 1
fi
DART="$SDK/bin/dart"
MELOS_SDK="--sdk-path=$SDK"
echo "Using Dart SDK: $DART"
echo "               $($DART --version 2>&1)"

# Format staged .dart files, but leave staging to the author: `git add`-ing them
# here would sweep in deliberately held-back hunks of a partially staged file.
STAGED_DART=$(git diff --cached --name-only --diff-filter=d -- '*.dart')
if [ -n "$STAGED_DART" ]; then
  echo "Resolving affected package dependencies before formatting..."
  if ! run_without_git_env melos $MELOS_SDK exec $SCOPE --fail-fast --no-flutter --dir-exists=lib -- dart pub get --offline ||
     ! run_without_git_env melos $MELOS_SDK exec $SCOPE --fail-fast --flutter --dir-exists=lib -- flutter pub get --offline; then
    echo "Dependency resolution failed. Run 'melos bootstrap' before committing." >&2
    exit 1
  fi
  echo "Checking formatting of staged .dart files..."
  if ! $DART format --set-exit-if-changed $STAGED_DART; then
    echo
    echo "Files were reformatted. Review, 'git add' them, and commit again."
    echo "If the diff looks unexpectedly large, run 'melos bootstrap' -- a stale"
    echo ".dart_tool from another branch changes dart_style's output."
    exit 1
  fi
fi

echo "Running pre-commit checks for:$NAMES"

run_without_git_env melos $MELOS_SDK exec $SCOPE --fail-fast --no-flutter --dir-exists=lib -- dart analyze --fatal-warnings &&
run_without_git_env melos $MELOS_SDK exec $SCOPE --fail-fast --flutter --dir-exists=lib -- flutter analyze --fatal-warnings
